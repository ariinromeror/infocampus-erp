# ============================================================
# frontend/.env.example
# Copia este archivo como .env para desarrollo local
# Para Vercel: configura estas variables en Project Settings > Environment Variables
# ============================================================

# URL de tu backend FastAPI
# LOCAL (desarrollo):
VITE_API_URL=http://127.0.0.1:8000/api

# PRODUCCIÓN (Render) — descomentar y ajustar con tu URL real:
# VITE_API_URL=https://infocampus-erp.onrender.com/api

# Sentry (opcional) — captura de errores del frontend en producción.
# Vacío/no definido: la app funciona igual, sin reporte de errores.
# Obtén el DSN en sentry.io > Settings > Projects > <tu-proyecto> > Client Keys (DSN).
# VITE_SENTRY_DSN=https://xxxxxxxx@oXXXXXX.ingest.sentry.io/XXXXXXX
