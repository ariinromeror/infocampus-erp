# InfoCampus ERP — Backend (.env.example)
# Copia este archivo como .env y completa los valores

# Base de datos PostgreSQL (Supabase)
DATABASE_URL=postgresql://usuario:password@host:5432/postgres

# JWT (genera una clave segura para producción)
SECRET_KEY_AUTH=tu_clave_secreta_muy_larga_y_aleatoria
ALGORITHM=HS256

# CORS (orígenes permitidos, separados por coma)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# IA / Groq (opcional, para chatbot Eva)
GROQ_API_KEY=

# Observability (opcional — ver docs/DEPLOY.md#observability-sentry)
# Sin SENTRY_DSN, el error tracking queda deshabilitado y la app funciona igual.
SENTRY_DSN=
ENVIRONMENT=development

# Acceso demo (RQ-01, docs/PRD.md) — ver README.md#demo-credentials-are-public-by-design.
# En "false", el login rechaza cualquier intento que use DEMO_PASSWORD (la
# contraseña universal sembrada por scripts_db/populate.py), sin afectar a
# cuentas con contraseña propia. El frontend también necesita
# VITE_ENABLE_DEMO_LOGIN=false para ocultar el panel de acceso rápido.
ENABLE_DEMO_LOGIN=true
DEMO_PASSWORD=campus2026
