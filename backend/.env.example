# InfoCampus ERP — Backend (.env.example)
# Copia este archivo como .env y completa los valores

# Entorno: "development" en local, "production" en Render.
# En "production" el servidor EXIGE ALLOWED_ORIGINS explícito (no hay
# fallback a wildcard '*'); en cualquier otro valor sí se permite el
# fallback para facilitar el desarrollo local.
ENVIRONMENT=development

# Base de datos PostgreSQL (Supabase)
DATABASE_URL=postgresql://usuario:password@host:5432/postgres

# JWT (genera una clave segura para producción)
SECRET_KEY_AUTH=tu_clave_secreta_muy_larga_y_aleatoria
ALGORITHM=HS256

# CORS (orígenes permitidos, separados por coma). Obligatorio en producción.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# IA / Groq (opcional, para chatbot Eva)
GROQ_API_KEY=

# Pool de conexiones PostgreSQL (asyncpg). El límite real de conexiones
# simultáneas es DB_POOL_MAX_SIZE × workers de Gunicorn (WEB_CONCURRENCY):
# no debe exceder el límite de conexiones del plan de Supabase contratado.
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=20

# Redis (opcional). Si se deja vacío, el sistema funciona igual pero sin
# cache (configuración institucional, dashboard institucional, revocación
# de tokens) ni la cola de background jobs (generación masiva de boletines,
# ver backend/services/task_queue.py).
REDIS_URL=

# Gunicorn (solo aplica al arrancar con `gunicorn`/Docker, no con `uvicorn`
# directo en desarrollo). Ajustar según CPU del plan contratado (regla:
# 2×núcleos+1).
WEB_CONCURRENCY=2
