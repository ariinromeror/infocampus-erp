# ============================================================
# .gitignore — InfoCampus ERP
# Coloca este archivo en la RAÍZ del repositorio
# ============================================================

# ── Secretos — NUNCA subir al repositorio ───────────────────
backend/.env
scripts_db/.env
frontend/.env
frontend/.env.local
frontend/.env.production

# ── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
*.egg
venv/
.venv/
env/
.env/

# ── Node / Frontend ─────────────────────────────────────────
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
*.local

# ── Supabase ─────────────────────────────────────────────────
supabase/.temp/
supabase/functions/.cache/

# ── IDE / OS ─────────────────────────────────────────────────
.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

# ── Logs ─────────────────────────────────────────────────────
*.log
logs/

# ── Artefactos generados por scripts_db/populate.py ─────────
# Contiene credenciales de las cuentas demo/seed (password compartida,
# datos falsos generados con Faker) — no debe versionarse igual.
scripts_db/credenciales_infocampus_*.txt

# ── Artefactos generados por jobs en background (backend/services/task_queue.py) ──
backend/generated_reports/

# ── Resultados de corridas de carga (backend/loadtest/) ─────
# CSVs de Locust: específicos de cada corrida/máquina, no aportan valor
# versionados. Los hallazgos relevantes se documentan en docs/DEPLOY.md.
backend/loadtest/resultados/
backend/loadtest/*.csv
